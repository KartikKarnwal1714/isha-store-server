# Copy this file to .env and fill in your own values.

MONGO_URI=your_mongodb_connection_string

PORT=5000

JWT_SECRET=choose_a_long_random_secret_string

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ======================================================
# ADMIN PORTAL LOGIN
# ======================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password

# ======================================================
# FAST2SMS (customer phone OTP login)
# Get your key from https://www.fast2sms.com -> Dev API -> API Key
# ======================================================
FAST2SMS_API_KEY=your_fast2sms_api_key_here

OTP_EXPIRY_MINUTES=5

# ======================================================
# TEST LOGIN (bypasses Fast2SMS during development)
# ======================================================
OTP_TEST_PHONE=9389948613
OTP_TEST_CODE=123456

# ======================================================
# RAZORPAY (payments)
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
# ======================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ======================================================
# CLIENT URLS (comma separated, no trailing slash)
# Used for CORS + Socket.IO so only your own frontends can call this API.
# Example: https://ishastore.com,https://admin.ishastore.com
# ======================================================
CLIENT_URLS=http://localhost:5173,http://localhost:5174
